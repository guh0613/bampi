DRIVER=~fastapi
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# 若 NapCat 启用 access token，需与协议端一致
# ACCESS_TOKEN=your_shared_token

# --- 模型（最小必填）---
BAMPI_MODEL_PROVIDER=openai
BAMPI_MODEL_ID=gpt-5-mini
BAMPI_MODEL_API=auto
BAMPI_API_KEY=
# BAMPI_BASE_URL=https://api.openai.com/v1

# 未注册的自定义模型默认可覆盖输入能力；须包含 text
# BAMPI_MODEL_INPUT_TYPES=["text"]
# BAMPI_THINKING_LEVEL=off

# --- 触发与身份（常用）---
# BAMPI_BOT_NAME=Ophelia
# BAMPI_TRIGGER_PREFIX=["@bot"]
# BAMPI_GROUP_WHITELIST=["123456789"]
# BAMPI_POKE_REPLY_ENABLED=true
# BAMPI_THINKING_REACTION_ENABLED=true
# BAMPI_THINKING_REACTION_EMOJI=仔细分析

# --- Pokémon Showdown 对战 ---
# SHOWDOWN_BATTLE_ENABLED=true
# SHOWDOWN_BATTLE_NODE_BIN=node
# SHOWDOWN_BATTLE_PACKAGE_DIR=node_modules/pokemon-showdown
# SHOWDOWN_BATTLE_DATA_DIR=data/showdown_battle
# SHOWDOWN_BATTLE_GROUP_WHITELIST=[]
# SHOWDOWN_BATTLE_TEAM_SOURCE_TIMEOUT_SECONDS=10
# SHOWDOWN_BATTLE_TEAM_SOURCE_CACHE_TTL_SECONDS=900
# SHOWDOWN_BATTLE_TEAM_GUIDE_TTL_SECONDS=900

# Showdown Bot 对手使用 BAMPI_BOT_NAME，并默认继承上面的 BAMPI 主模型
# SHOWDOWN_BATTLE_AI_ENABLED=true
# SHOWDOWN_BATTLE_AI_MODEL_PROVIDER=
# SHOWDOWN_BATTLE_AI_MODEL_ID=
# SHOWDOWN_BATTLE_AI_MODEL_API=auto
# SHOWDOWN_BATTLE_AI_API_KEY=
# SHOWDOWN_BATTLE_AI_BASE_URL=
# SHOWDOWN_BATTLE_AI_THINKING_LEVEL=
# SHOWDOWN_BATTLE_AI_DECISION_TIMEOUT_SECONDS=60
# SHOWDOWN_BATTLE_AI_COMMENTARY_ENABLED=true
# SHOWDOWN_BATTLE_AI_COMMENTARY_MAX_CHARS=500
# 留空时继承 BAMPI_PERSONA；仅在希望对战人格不同于群聊时设置
# SHOWDOWN_BATTLE_AI_PERSONA=

# --- QQ 合并转发（按触发后读取，无需开启 NapCat parseMultMsg）---
# BAMPI_FORWARD_ENABLED=true
# BAMPI_FORWARD_MAX_DEPTH=4
# BAMPI_FORWARD_MAX_NODES=100
# BAMPI_FORWARD_MAX_TEXT_CHARS=30000

# --- 沙箱 ---
# BAMPI_BASH_MODE=docker
# BAMPI_BASH_CONTAINER_NAME=bampi-sandbox

# 完整说明见 docs/guide/configuration.md
