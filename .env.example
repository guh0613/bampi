DRIVER=~fastapi
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# 若 NapCat 启用 access token，需与协议端一致
# ACCESS_TOKEN=your_shared_token

# --- 模型（最小必填）---
BAMPI_MODEL_PROVIDER=openai
BAMPI_MODEL_ID=gpt-5-mini
BAMPI_MODEL_API=auto
BAMPI_API_KEY=
# BAMPI_BASE_URL=https://api.openai.com/v1

# 未注册的自定义模型默认可覆盖输入能力；须包含 text
# BAMPI_MODEL_INPUT_TYPES=["text"]
# BAMPI_THINKING_LEVEL=off

# --- 触发（常用）---
# BAMPI_TRIGGER_PREFIX=["@bot"]
# BAMPI_GROUP_WHITELIST=["123456789"]
# BAMPI_POKE_REPLY_ENABLED=true

# --- 沙箱 ---
# BAMPI_BASH_MODE=docker
# BAMPI_BASH_CONTAINER_NAME=bampi-sandbox

# 完整说明见 docs/guide/configuration.md
