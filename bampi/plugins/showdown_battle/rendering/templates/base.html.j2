<!doctype html>
<html lang="zh-Hans">
<head>
<meta charset="utf-8">
<style>
@font-face {
  font-family: "Fusion Pixel";
  src: url("{{ font_url }}") format("woff2");
}

:root {
  --page-bg: #16162c;
  --page-grid: #1c1c36;
  --ink: #2a2438;
  --ink-soft: #4a4462;
  --cream: #f8f0dc;
  --cream-hi: #fffdf2;
  --cream-lo: #cabf9e;
  --text-on-cream: #33304a;
  --muted-on-cream: #7a7290;
  --p1: #4a9df8;
  --p1-deep: #2d5fb8;
  --p2: #f8607a;
  --p2-deep: #c23350;
  --gold: #ffd23e;
  --hp-high: #48c878;
  --hp-mid: #f0b83e;
  --hp-low: #e8506a;
  --sky-a: #7fc4ef;
  --sky-b: #b0e0f8;
  --ground: #6db95e;
  --ground-deep: #4f9b45;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html { -webkit-font-smoothing: none; }

body {
  width: {{ width }}px;
  font-family: "Fusion Pixel", "PingFang SC", "Noto Sans SC", sans-serif;
  font-size: 24px;
  line-height: 1.5;
  color: var(--cream);
  background:
    repeating-linear-gradient(0deg, transparent 0 6px, var(--page-grid) 6px 12px),
    var(--page-bg);
  padding: 22px 22px 18px;
}

img.sprite { image-rendering: pixelated; display: block; }

.item-icon {
  flex: 0 0 auto;
  width: 24px;
  height: 24px;
  image-rendering: pixelated;
  vertical-align: middle;
}

/* ---------------------------------------------------------- header --- */

.scoreboard {
  display: flex;
  align-items: stretch;
  gap: 14px;
  margin-bottom: 12px;
}

.plate {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  align-items: center;
  padding: 8px 16px;
  border: 3px solid var(--ink);
  box-shadow: 0 4px 0 rgba(0, 0, 0, 0.4), inset 0 0 0 2px rgba(255, 255, 255, 0.25);
  font-size: 30px;
  line-height: 1.3;
}

.plate .plate-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plate.p1 {
  background: linear-gradient(180deg, var(--p1) 0%, var(--p1-deep) 100%);
  justify-content: flex-start;
}

.plate.p2 {
  background: linear-gradient(180deg, var(--p2) 0%, var(--p2-deep) 100%);
  justify-content: flex-end;
  text-align: right;
}

.vs {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  font-size: 36px;
  color: var(--gold);
  text-shadow: 3px 3px 0 rgba(0, 0, 0, 0.6);
}

/* Poké-ball roster indicators */

.plate-col {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.plate-col .plate { flex: 1 1 auto; }

.ball-row {
  display: flex;
  align-items: center;
  gap: 6px;
}

.ball-row.p2 { justify-content: flex-end; }

.ball {
  flex: 0 0 auto;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  border: 3px solid var(--ink);
  position: relative;
  background: linear-gradient(180deg, #f85868 0 40%, var(--ink) 40% 60%, #f4eee0 60% 100%);
  box-shadow: 0 2px 0 rgba(0, 0, 0, 0.35);
}

.ball::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  width: 8px;
  height: 8px;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: #fff;
  border: 2px solid var(--ink);
  box-sizing: border-box;
}

.ball.fainted {
  background: linear-gradient(180deg, #8a8496 0 40%, var(--ink) 40% 60%, #b6b0a4 60% 100%);
  opacity: 0.7;
}

.ball.fainted::after { background: #d0ccc2; }

.ball.unknown {
  background: #cfc9ba;
  opacity: 0.45;
}

.ball.unknown::after { background: #e8e2d4; }

.subhead {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 14px;
  font-size: 18px;
  color: #a8b4d8;
}

.subhead .doc-title {
  color: var(--gold);
}

.subhead .spacer { flex: 1 1 auto; }

.turn-chip {
  background: var(--gold);
  color: #3a2c00;
  border: 3px solid var(--ink);
  padding: 1px 12px;
  font-size: 18px;
  box-shadow: 0 3px 0 rgba(0, 0, 0, 0.4);
}

/* ------------------------------------------------------ components --- */

.dialog {
  background: var(--cream);
  border: 4px solid var(--ink);
  box-shadow:
    inset 0 0 0 3px var(--cream-hi),
    inset 0 0 0 5px var(--cream-lo),
    0 5px 0 rgba(0, 0, 0, 0.4);
  color: var(--text-on-cream);
  padding: 18px 22px;
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border: 2px solid var(--ink);
  padding: 0 10px;
  font-size: 18px;
  line-height: 1.6;
  background: var(--cream);
  color: var(--text-on-cream);
  box-shadow: 0 2px 0 rgba(0, 0, 0, 0.35);
  white-space: nowrap;
}

.chip .chip-label {
  color: var(--muted-on-cream);
}

.status-chip {
  display: inline-block;
  border: 2px solid var(--ink);
  padding: 0 8px;
  font-size: 18px;
  line-height: 1.5;
  color: #fff;
  white-space: nowrap;
}

.st-brn { background: #e07038; }
.st-par { background: #c8a828; }
.st-slp { background: #8878a8; }
.st-psn { background: #a850c8; }
.st-tox { background: #7a3a9a; }
.st-frz { background: #50a8d8; }
.st-fnt { background: #5a5a6a; }
.st-generic { background: #6a7a9a; }

.tera-chip {
  display: inline-block;
  border: 2px solid var(--ink);
  padding: 0 8px;
  font-size: 18px;
  line-height: 1.5;
  background: linear-gradient(135deg, #8ae0f8 0%, #c8a0f8 100%);
  color: #2a2050;
  white-space: nowrap;
}

.pos-badge {
  display: inline-block;
  border: 2px solid var(--ink);
  padding: 0 6px;
  font-size: 18px;
  line-height: 1.5;
  background: var(--ink-soft);
  color: #e8e4f8;
  white-space: nowrap;
}

/* HP bar */

.hp-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.hp-tag {
  font-size: 18px;
  color: #e8a020;
  text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.25);
}

.hp-bar {
  flex: 1 1 auto;
  height: 14px;
  background: #4a4462;
  border: 2px solid var(--ink);
  padding: 2px;
}

.hp-fill {
  height: 100%;
  min-width: 2px;
}

.hp-fill.hp-high { background: linear-gradient(180deg, #78e8a0 0%, var(--hp-high) 60%); }
.hp-fill.hp-mid { background: linear-gradient(180deg, #f8d878 0%, var(--hp-mid) 60%); }
.hp-fill.hp-low { background: linear-gradient(180deg, #f89098 0%, var(--hp-low) 60%); }
.hp-fill.hp-empty { background: transparent; min-width: 0; }

.sprite-missing {
  width: 96px;
  height: 96px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36px;
  color: rgba(255, 255, 255, 0.7);
  background:
    repeating-conic-gradient(rgba(255, 255, 255, 0.12) 0% 25%, transparent 0% 50%)
    0 0 / 24px 24px;
  border: 2px dashed rgba(255, 255, 255, 0.4);
}

.footer {
  margin-top: 14px;
  font-size: 18px;
  color: #6a7498;
  text-align: center;
}

{% block extra_css %}{% endblock %}
</style>
</head>
<body>
{% block content %}{% endblock %}
</body>
</html>
